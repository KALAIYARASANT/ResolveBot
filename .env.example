# Source files and SQLite database (paths may be absolute or relative to the project)
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db

# Business date: deliberately independent of the system clock
APP_TODAY=2026-07-01

# LLM configuration. Only "openai" is supported; any other LLM_PROVIDER stops the service at startup with a clear error.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Any chat model your key can use that supports function calling and temperature 0 (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Leave empty for ordinary chat models. Reasoning models that reject temperature 0 need their reasoning
# disabled, for example OPENAI_MODEL=gpt-6-luna with OPENAI_REASONING_EFFORT=none.
OPENAI_REASONING_EFFORT=
